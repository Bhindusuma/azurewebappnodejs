# Local development. On Azure these become App Settings, not a file.
PORT=8080
NODE_ENV=development

# 32+ random chars. In Azure, store in Key Vault and reference from App Settings:
# @Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/jwt-secret/)
JWT_SECRET=change-me-to-a-long-random-string

# Leave empty to run against the built-in in-memory store (seeded demo data).
# Set to an Azure Database for PostgreSQL connection string in production.
# DATABASE_URL=postgresql://user:pass@myserver.postgres.database.azure.com:5432/kiln?sslmode=require
DATABASE_URL=
