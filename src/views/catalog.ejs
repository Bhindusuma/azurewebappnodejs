<%- include('partials/head') %>
<div class="shell">
  <section class="opening">
    <h1>Courses</h1>
    <p class="lede">Every course is four lessons. Start anywhere; nothing assumes you
       have taken the others.</p>
  </section>
  <ul class="courses">
    <% courses.forEach(function (c) { %>
      <li>
        <a class="course-row" href="/courses/<%= c.slug %>">
          <h3><%= c.title %></h3>
          <div class="figures">
            <div class="meta"><%= c.lesson_count %> lessons</div>
            <div class="meta"><%= Math.round(c.minutes / 60) %> hours</div>
          </div>
          <p><%= c.description %></p>
          <div class="meta"><%= c.level %> · Taught by <%= c.instructor %></div>
        </a>
      </li>
    <% }); %>
  </ul>
</div>
<%- include('partials/foot') %>
