<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Kiln</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Public+Sans:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/app.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="masthead">
  <div class="shell masthead__inner">
    <a class="wordmark" href="<%= user ? '/dashboard' : '/' %>">Kiln</a>
    <nav>
      <a href="/catalog">Courses</a>
      <% if (user) { %>
        <a href="/dashboard">Your learning</a>
        <form method="post" action="/logout">
          <button class="btn--plain" type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a href="/login">Sign in</a>
        <a href="/register">Create account</a>
      <% } %>
    </nav>
  </div>
</header>
<main id="main">
